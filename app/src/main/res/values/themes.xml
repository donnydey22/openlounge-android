<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenLounge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/openlounge_accent</item>
        <item name="colorPrimaryVariant">@color/openlounge_green</item>
        <item name="colorOnPrimary">@color/openlounge_bg</item>
        <item name="colorSecondary">@color/openlounge_green</item>
        <item name="android:statusBarColor">@color/openlounge_bg</item>
        <item name="android:navigationBarColor">@color/openlounge_bg</item>
        <item name="android:windowBackground">@color/openlounge_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch theme: plain web-app background, no icon (wordmark animates in LaunchOverlay) -->
    <style name="Theme.OpenLounge.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenLounge</item>
    </style>

    <!-- 0.3.1 full-screen incoming call (plain Activity, over the lock screen) -->
    <style name="Theme.OpenLounge.IncomingCall" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:statusBarColor">@color/launch_bg</item>
        <item name="android:navigationBarColor">@color/launch_bg</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>
</resources>
